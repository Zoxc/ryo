/-
The JIT's handler effect table (`vm/bytecode/src/jit/effects.rs`, `RyoTest/EffectsVectors.lean`,
generated by `vm/bytecode/tests/lean_effects.rs`) against opSem's footprints
(`Ryo/Vm/OpSem/Footprint.lean`; reduced.md Part D, jit.md §E.7): the footprint, mapped to the
JIT's vocabulary, must equal the table for every opcode with a handler, so the two can't drift.

The mapping, per `Slot`/`Mem` operand (in `OpInfo.operands` order; other operands have none):
- address taken (`addrs`) → `addr`;
- read at a fixed width `n` (a `Mem` operand's pointer slot: 8) → `read n`; written at `n` →
  `write n`;
- accessed at a length the operands give (`opnd`, `mul`: `copy`, `const`, `zero`, `fill`,
  `load.copy`, `store.copy`) → `block`;
- not named → none.
And `memory` ↔ a deref through a pointer that comes from the frame (`PtrSrc.slot`, `.mem`:
loads, stores, `memcpy`/`memmove`/`memset`, atomics), or a fence. Two things differ only in
vocabulary:
- Derefs through address operands (`PtrSrc.addr`, `.loaded`: `const`'s and `fill`'s pool
  bytes, `switch.sparse`'s case list, `addr.sym`'s symbol slot and `addr.sym.ind`'s pointer
  in it) read the image's read-only data, which no store can change; opSem lists them (they
  are L0 accesses with provenance) but they don't order against, or alias, the program's
  memory accesses, so the JIT's `memory` leaves them out.
- Fences have an empty footprint (opSem is sequentially consistent: a fence does nothing),
  but the JIT's `memory` also means "orders memory accesses", so it has them.
`resume`'s handler is assembly, outside opSem (no footprint); the table has it (it reads the
exception slot `x`), which this test can't check.
-/
import RyoTest.Harness
import RyoTest.EffectsVectors

namespace RyoTest.Effects

open Ryo.Vm Ryo.Vm.OpSem Ryo.Vm.Handlers
open EffectsVectors (Effect)

/-- The JIT effect of operand `name` under the footprint `fp` (`error` for a combination the
mapping has no word for). -/
def opndEffect (fp : Footprint) (name : String) : Except String (Option Effect) := do
  if fp.addrs.contains name then
    if fp.reads.any (·.opnd == name) || fp.writes.any (·.opnd == name) then
      throw s!"{name} is both address-taken and accessed"
    return some .addr
  let rs := (fp.reads.filter (·.opnd == name)).map (·.extent)
  let ws := (fp.writes.filter (·.opnd == name)).map (·.extent)
  let lengthDep : Extent → Bool
    | .opnd _ | .mul _ _ => true
    | _ => false
  match rs, ws with
  | [], [] => return none
  | [.bytes n], [] => return some (.read n)
  | [], [.bytes n] => return some (.write n)
  | _, _ =>
    if (rs ++ ws).all lengthDep then return some .block
    throw s!"{name}: no JIT effect for reads {repr rs}, writes {repr ws}"

def isFence (op : Full.Opcode) : Bool :=
  match op.handler? with
  | some h => h.kind == .fence || h.kind == .compiler_fence
  | none => false

/-- The footprint of `op` in the JIT's vocabulary (see the module doc). -/
def jitEffects (op : Full.Opcode) (fp : Footprint) : Except String EffectsVectors.Effects := do
  let opnds ← op.info.operands.mapM fun o =>
    if o.kind == .slot || o.kind == .mem then opndEffect fp o.name else pure none
  -- Every name the footprint uses is a frame operand (`RyoTest/OpSem.lean`'s
  -- `footprint-names`), so nothing is dropped above.
  let fromFrame : PtrSrc → Bool
    | .slot _ | .mem _ => true
    | .addr _ | .loaded _ => false
  pure { opnds, memory := fp.derefs.any (fromFrame ·.src) || isFence op }

/-- Opcodes whose table entry disagrees with opSem, where the table is wrong (each with why).
Empty: none found. -/
def knownDisagreements : List String := []

/-- Opcodes the table has but opSem can't check (see the module doc). -/
def unchecked : List String := ["resume"]

def agree : Except String Unit := do
  let names := EffectsVectors.effects.map (·.1)
  check (names == Full.all.map (·.info.mnemonic)) "the vectors' opcodes differ from Full.all"
  let mut checked := 0
  for (m, rust) in EffectsVectors.effects do
    let some op := Full.Opcode.ofMnemonic? m | throw s!"no opcode {m}"
    if unchecked.contains m then
      check (footprint op).isNone s!"{m}: unchecked, but has a footprint"
      check rust.isSome s!"{m}: unchecked, but has no effects"
      continue
    match footprint op, rust with
    | none, none => pure ()
    | some _, none => throw s!"{m}: a footprint, but no JIT effects"
    | none, some _ => throw s!"{m}: JIT effects, but no footprint"
    | some fp, some r =>
      let lean ← (jitEffects op fp).mapError (s!"{m}: " ++ ·)
      if knownDisagreements.contains m then
        check (lean != r) s!"{m}: listed as a known disagreement, but agrees"
      else
        check (lean == r) s!"{m}: the JIT's effects {repr r}, opSem's footprint gives {repr lean}"
        checked := checked + 1
  check (checked > 600) s!"only {checked} opcodes checked"

/-- The mapping's cases, on known opcodes. -/
def mapping : Except String Unit := do
  let e (m : String) : Except String EffectsVectors.Effects := do
    let some op := Full.Opcode.ofMnemonic? m | throw s!"no opcode {m}"
    let some fp := footprint op | throw s!"{m}: no footprint"
    jitEffects op fp
  check ((← e "add.w32") == { opnds := [some (.write 4), some (.read 4), some (.read 4)], memory := false })
    "add.w32"
  check ((← e "addr").opnds.contains (some .addr)) "addr"
  check ((← e "copy").opnds.contains (some .block)) "copy is a block"
  check (← e "load.w32").memory "load touches memory"
  check (← e "fence.seqcst").memory "a fence orders memory"
  check (!(← e "addr.sym.ind").memory) "addr.sym.ind reads read-only image data"
  check (!(← e "switch.sparse.w32").memory) "switch.sparse reads read-only image data"

def tests : List TestCase := [
  ⟨"Effects/mapping", fun _ => mapping⟩,
  ⟨"Effects/agree", fun _ => agree⟩,
]

end RyoTest.Effects
