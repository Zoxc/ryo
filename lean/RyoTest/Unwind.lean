/-
Tests of the unwind-table readers (`Ryo/Obj/Lsda.lean`, `Ryo/Obj/EhFrame.lean`): the LSDA
round trip and rejections, Rust's `lsda::parse` verdicts on written and mutated LSDAs, and the
row tables of `image::eh_fde`'s FDEs in both frame modes (`RyoTest/UnwindVectors.lean`,
generated by `vm/bytecode/tests/lean_unwind_vectors.rs`) against the rules `eh_fde`
documents. The readers are checked on real image objects by `scripts/lean-decode-diff.py
--unwind` (against readelf and Rust).
-/
import RyoTest.Harness
import RyoTest.UnwindVectors

namespace RyoTest.Unwind

open Ryo.Obj Ryo.Obj.EhFrame

deriving instance Repr for UnwindVectors.Fde

def bytes (l : List UInt8) : ByteArray := ⟨l.toArray⟩

def ofHex (s : String) : ByteArray :=
  let digit (c : Char) : Nat :=
    if c.isDigit then c.toNat - '0'.toNat else c.toNat - 'a'.toNat + 10
  let cs := s.toList.toArray
  bytes ((List.range (cs.size / 2)).map fun i => (digit cs[2 * i]! * 16 + digit cs[2 * i + 1]!).toUInt8)

/-- Rust's text of a `parse` result (see the vectors' `Lsda.out`). -/
def sitesText : Option (Array CallSite) → String
  | none => "none"
  | some v => String.join (v.toList.map fun c =>
      s!"{c.start} {c.len} {match c.pad with | some p => toString (p : Int) | none => "-1"} {if c.catches then 1 else 0};")

def check (b : Bool) (msg : String) : Except String Unit := if b then .ok () else .error msg

/-! ## LSDA -/

def lsdaRoundTrip : Except String Unit := do
  let cases : List (Array CallSite) := [
    #[], #[⟨0, 5, none, false⟩], #[⟨1, 2, some 3, true⟩],
    #[⟨10, 5, some 200, false⟩, ⟨300, 6, none, false⟩, ⟨70000, 128, some 0xffffffff, true⟩]]
  for s in cases do
    let b := Lsda.write s
    check (Lsda.parse b == some s) s!"round trip of {repr s}: {sitesText (Lsda.parse b)}"
  check (Lsda.write #[⟨1, 2, some 3, true⟩] == bytes [0xff, 0xff, 1, 4, 1, 2, 3, 1, 1, 0]) "write of one catching site"
  check (Lsda.write #[] == bytes [0xff, 0xff, 1, 0]) "write of no sites"
  check (Lsda.write #[⟨200, 1, none, false⟩] == bytes [0xff, 0xff, 1, 5, 0xc8, 1, 1, 0, 0]) "write of a two-byte start"

def lsdaReject : Except String Unit := do
  let rejects : List (String × List UInt8) := [
    ("bad header", [0xff, 0xfe, 1, 0]),
    ("ttype present", [0xff, 0x9b, 1, 0]),
    ("call-site encoding udata4", [0xff, 0xff, 3, 0]),
    ("action 2", [0xff, 0xff, 1, 4, 0, 1, 2, 2]),
    ("action 1 without a pad", [0xff, 0xff, 1, 4, 0, 1, 0, 1, 1, 0]),
    ("trailing junk", [0xff, 0xff, 1, 4, 0, 1, 2, 0, 0]),
    ("trailing action record without a catch", [0xff, 0xff, 1, 4, 0, 1, 2, 0, 1, 0]),
    ("missing action record", [0xff, 0xff, 1, 4, 0, 1, 2, 1]),
    ("table cut short", [0xff, 0xff, 1, 8, 0, 1, 2, 0]),
    ("value past u32", [0xff, 0xff, 1, 8, 0xff, 0xff, 0xff, 0xff, 0x1f, 1, 2, 0]),
    ("seven groups", [0xff, 0xff, 1, 0x80, 0x80, 0x80, 0x80, 0x80, 0x80, 0])]
  for (what, b) in rejects do
    check (Lsda.parse (bytes b) == none) s!"{what} accepted"
  -- Six groups are read (`parse`'s shift limit), and the length is counted canonically: the
  -- padded length `80 80 80 80 80 00` reads as 0 but counts as one byte, so the table ends
  -- right after its first byte and the rest is junk.
  check (Lsda.parse (bytes [0xff, 0xff, 1, 0x80, 0x80, 0x80, 0x80, 0x80, 0]) == none) "padded length accepted"

def lsdaVectors : Except String Unit := do
  let mut n := 0
  for v in UnwindVectors.lsdas do
    let got := sitesText (Lsda.parse (ofHex v.bytes))
    check (got == v.out) s!"LSDA {v.bytes}: Lean {got}, Rust {v.out}"
    n := n + 1
  check (n > 300) s!"only {n} LSDA vectors"

/-! ## `.eh_frame` -/

/-- Unrelocated: a pointer is relative to its field, 0 null (section 0 stands for
`.eh_frame`). -/
def rawResolve : Resolve := fun pos raw =>
  .ok (if raw == 0 then .null else .to (.sect 0 ((pos : Int) + raw)))

def ra : List (Nat × Int) := [(16, -8)]

/-- The rows `eh_fde` documents: from the CIE's `CFA = rsp + 8` (the return address at
CFA − 8); with a frame pointer, after `push rbp` the CFA is `rsp + 16` with `rbp` at CFA − 16
and after `mov rbp, rsp` `rbp + 16`; without, after the prologue `rsp + F + 16`; in the
entry's stub `rsp + 8` again, `rbp` not saved. -/
def expectedRows (v : UnwindVectors.Fde) : Array Row :=
  let entry : State := ⟨7, 8, ra⟩
  let body := if v.framePointer then
      #[⟨v.prologue + 1, ⟨7, 16, (6, -16) :: ra⟩⟩, ⟨v.prologue + 4, ⟨6, 16, (6, -16) :: ra⟩⟩]
    else #[⟨v.prologue + v.prologueLen, ⟨7, v.frameSize + 16, ra⟩⟩]
  #[⟨0, entry⟩] ++ body ++ (if v.entryStub < v.len then #[⟨v.entryStub, entry⟩] else #[])

def fdeVectors : Except String Unit := do
  let mut n := 0
  let mut modes := (false, false, false)
  for v in UnwindVectors.fdes do
    let eh ← EhFrame.parse (ofHex v.eh) rawResolve
    let [c] := eh.cies.toList | throw "not one CIE"
    let [f] := eh.fdes.toList | throw "not one FDE"
    check (c.offset == 0 && c.version == 1 && c.augmentation == "zPLR" && c.codeAlign == 1 && c.dataAlign == -8
      && c.raReg == 16 && c.lsdaEnc == some 0x1b && c.fdeEnc == 0x1b) s!"CIE fields: {repr c}"
    let some p := c.personality | throw "no personality"
    check (p.enc == 0x9b && p.pos == 19 && p.value == .null) s!"personality {repr p}"
    check (c.initial == ⟨7, 8, ra⟩) s!"CIE rules {repr c.initial}"
    check (f.offset == v.fde && f.cie == 0 && f.pcRange == v.len) s!"FDE fields {repr f}"
    check (f.pcBegin == ⟨v.pcBegin, 0x1b, .null⟩) s!"pc_begin {repr f.pcBegin}"
    check (f.lsda == some ⟨v.lsda, 0x1b, .null⟩) s!"LSDA pointer {repr f.lsda}"
    let want := expectedRows v
    check (f.rows == want) s!"FDE {repr v}: rows {repr f.rows}, expected {repr want}"
    n := n + 1
    modes := (modes.1 || v.framePointer, modes.2.1 || !v.framePointer, modes.2.2 || v.entryStub < v.len)
  check (n > 40 && modes == (true, true, true)) s!"{n} FDE vectors, modes {modes}"

/-- The vector's bytes with byte `i` set to `b`. -/
def patch (s : String) (edits : List (Nat × UInt8)) : ByteArray :=
  edits.foldl (fun (a : ByteArray) (i, b) => a.set! i b) (ofHex s)

def fdeReject : Except String Unit := do
  let some v := UnwindVectors.fdes.find? (·.framePointer) | throw "no frame-pointer vector"
  let ok := EhFrame.parse (ofHex v.eh) rawResolve
  check ok.toBool "the vector itself rejected"
  let f := v.fde
  -- CIE: version 1 at 8, "zPLR\0" at 9, alignment, RA at 16, augmentation length 17,
  -- P encoding 18, pointer 19..22, L 23, R 24, instructions from 25.
  let rejects : List (String × ByteArray) := [
    ("CIE version 3", patch v.eh [(8, 3)]),
    ("augmentation zPLS", patch v.eh [(12, 0x53)]),
    ("personality encoding absptr", patch v.eh [(18, 0x00)]),
    ("LSDA encoding indirect", patch v.eh [(23, 0x9b)]),
    ("FDE encoding udata4", patch v.eh [(24, 0x03)]),
    ("augmentation length 6", patch v.eh [(17, 6)]),
    ("DW_CFA_remember_state", patch v.eh [(25, 0x0a)]),
    ("an advance in the CIE", patch v.eh [(28, 0x41)]),
    ("FDE's CIE pointer off", patch v.eh [(f + 4, (f + 4 + 8).toUInt8)]),
    ("DW_CFA_undefined in the FDE", patch v.eh [(f + 21, 0x07)]),
    ("64-bit entry", patch v.eh [(0, 0xff), (1, 0xff), (2, 0xff), (3, 0xff)]),
    ("entry past the end", (ofHex v.eh).extract 0 ((ofHex v.eh).size - 1))]
  for (what, b) in rejects do
    check (!(EhFrame.parse b rawResolve).toBool) s!"{what} accepted"
  -- A zero length ends the section.
  let terminated := (ofHex v.eh) ++ bytes [0, 0, 0, 0, 0xde, 0xad]
  check ((EhFrame.parse terminated rawResolve).toOption.map (·.fdes.size) == some 1) "terminator not read"

def tests : List TestCase := [
  ⟨"Unwind/lsda-round-trip", fun _ => lsdaRoundTrip⟩,
  ⟨"Unwind/lsda-reject", fun _ => lsdaReject⟩,
  ⟨"Unwind/lsda-vectors", fun _ => lsdaVectors⟩,
  ⟨"Unwind/fde-vectors", fun _ => fdeVectors⟩,
  ⟨"Unwind/fde-reject", fun _ => fdeReject⟩,
]

end RyoTest.Unwind
