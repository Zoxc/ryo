/-
RyoTest.X86 — tests of the L2 x86 model (`Ryo.X86`):

- the Rust encoder's vectors (`RyoTest/X86Vectors.lean`, generated by
  `vm/bytecode/tests/lean_x86_vectors.rs`): `encode` reproduces each item's bytes and
  relocations, `link` its linked bytes, and `decodeItem` reads them back, unlinked, linked and
  without a frame pointer; on mutated encodings `decodeItem` agrees with the Rust decoder
  (accepts the same item and length, or rejects); `osrCode` reproduces `osr_code`'s bytes and
  `decodeOsr` reads them back;
- round trips over a generated item set (every form × register × width × displacement and
  immediate size class);
- byte vectors of the extra forms (JIT entry prefix, registry constructor, trip stubs);
- `Item.exec` unit tests with known results and flags, and the add/sub flags against an
  independent integer formulation.
-/
import RyoTest.Harness
import RyoTest.X86Vectors
import Ryo.X86

set_option linter.constructorNameAsVariable false

namespace RyoTest.X86

open Lean Ryo.X86

/-! ### Helpers -/

def hexDigit (c : Char) : Option Nat :=
  if '0' ≤ c ∧ c ≤ '9' then some (c.toNat - '0'.toNat)
  else if 'a' ≤ c ∧ c ≤ 'f' then some (c.toNat - 'a'.toNat + 10)
  else none

def unhex (s : String) : Option (List UInt8) :=
  go s.toList
where
  go : List Char → Option (List UInt8)
    | [] => some []
    | a :: b :: rest => do
      let x ← hexDigit a
      let y ← hexDigit b
      pure (UInt8.ofNat (16 * x + y) :: (← go rest))
    | [_] => none

def hex (bs : List UInt8) : String :=
  String.join (bs.map fun b =>
    let d := Nat.toDigits 16 b.toNat
    String.ofList (if d.length < 2 then '0' :: d else d))

/-- Where references live in linked code: the map of `lean_x86_vectors.rs` (`addr_of`). -/
def code0 : BitVec 64 := 0x4000_0000
def record0 : BitVec 64 := 0x6000_0000

def addrOf : RefAddr
  | .handler op => 0x1000_0000 + BitVec.ofNat 64 (16 * op)
  | .probe => 0x1800_0000
  | .func f => 0x2000_0000 + BitVec.ofNat 64 (16 * f)
  | .sym s => 0x2800_0000 + BitVec.ofNat 64 (8 * s)
  | .site s => 0x3000_0000 + BitVec.ofNat 64 (8 * s)
  | .const k => 0x5000_0000 + BitVec.ofNat 64 k
  | .data d => 0x5800_0000 + BitVec.ofNat 64 d
  | .ro o => 0x6800_0000 + BitVec.ofNat 64 o
  | .record => record0
  | .recordLoopCtr => record0 + BitVec.ofNat 64 loopCtr

/-- Its inverse (`Link::resolve`); handlers below the opcode count the vectors use. -/
def resolve : LinkMap := fun a =>
  let base := a.toNat / 0x800_0000 * 0x800_0000
  let off := a.toNat % 0x800_0000
  let idx (k : Nat) : Option Nat := if off % k == 0 then some (off / k) else none
  match base with
  | 0x1000_0000 => (idx 16).bind fun op => if op < 0x10000 then some (.handler op) else none
  | 0x1800_0000 => if off == 0 then some .probe else none
  | 0x2000_0000 => (idx 16).map .func
  | 0x2800_0000 => (idx 8).map .sym
  | 0x3000_0000 => (idx 8).map .site
  | 0x5000_0000 => some (.const off)
  | 0x5800_0000 => some (.data off)
  | 0x6800_0000 => some (.ro off)
  | _ => none

/-- A function of `len` zero bytes but for `bytes` at `pos`. -/
def placed (pos len : Nat) (bytes : List UInt8) : Array UInt8 :=
  let pre := List.replicate pos (0 : UInt8)
  let post := List.replicate (len - pos - bytes.length) (0 : UInt8)
  (pre ++ bytes.take (len - pos) ++ post).toArray

def get {α : Type} [FromJson α] (j : Json) (k : String) : Except String α := do
  fromJson? (← j.getObjVal? k)

def getOpt {α : Type} [FromJson α] (j : Json) (k : String) : Except String (Option α) :=
  match j.getObjVal? k with
  | .ok .null => pure none
  | .ok v => some <$> fromJson? v
  | .error _ => pure none

def vectors : Array Json :=
  match Json.parse X86Vectors.json with
  | .ok (.arr a) => a
  | _ => #[]

def ofKind (k : String) : Array Json :=
  vectors.filter fun j => (j.getObjValAs? String "k").toOption == some k

/-- Runs `check` on each vector, reporting the first few failures. -/
def checkAll (vs : Array Json) (check : Json → Except String Unit) : Except String Unit := do
  if vs.isEmpty then throw "no vectors"
  let fails := vs.toList.filterMap fun j => match check j with
    | .ok () => none
    | .error e => some s!"{e}\n  in {j.compress}"
  if fails.isEmpty then pure ()
  else throw s!"{fails.length} of {vs.size} failed:\n{"\n".intercalate (fails.take 5)}"

def expectEq {α : Type} [BEq α] [Repr α] (what : String) (got want : α) : Except String Unit :=
  if got == want then pure () else throw s!"{what}: got {repr got}, want {repr want}"

/-! ### The Rust vectors -/

/-- Reads `items` one after the other from `c` (`decodeItem`), each to itself. -/
def decodeSeq (c : Cursor) (items : List Item) : Except String Unit := do
  let mut pos := c.pos
  for i in items do
    match decodeItem { c with pos } with
    | some (j, n) =>
      if j != i then throw s!"at {pos}: decoded {repr j}, want {repr i}"
      pos := pos + n
    | none => throw s!"at {pos}: no item, want {repr i}"
  if pos != c.pos + (encodeItems items c.pos).1.length then throw "decoded length"

/-- An encoding vector of Rust's `Item::WinPrologue` or `Item::WinEpilogue`: `items`, their
instructions here, encode to its bytes and decode back one after the other, unlinked and linked;
and none past the first decodes alone (Rust reads the sequence only as a whole). -/
def checkWinSeq (j : Json) (items : List Item) : Except String Unit := do
  let pos : Nat ← get j "pos"
  let len : Nat ← get j "len"
  let bytes ← (unhex (← get j "bytes")).elim (throw "bad hex") pure
  let linked : Option String ← getOpt j "linked"
  let (bs, rs) := encodeItems items pos
  expectEq "bytes" (hex bs) (hex bytes)
  expectEq "relocs" rs []
  let mut p := pos
  for i in items do
    if !i.wf (BitVec.ofNat 32 p) then throw s!"{repr i} not wf"
    p := p + i.len
  let code := placed pos len bytes
  decodeSeq { code, pos, fields := .relocs #[] } items
  if let some l := linked then
    expectEq "linked bytes" l (hex bytes)
    decodeSeq { code, pos, fields := .linked code0 record0 resolve } items
  let mut q := pos
  for i in items do
    let alone := placed q (q + i.len + 4) (i.encode (BitVec.ofNat 32 q)).1
    if q != pos && ((decodeItem { code := alone, pos := q, fields := .relocs #[] }).map (·.1)) == some i then
      throw s!"{repr i} decoded alone"
    q := q + i.len

/-- An encoding vector: `encode` (of the item, or its `sp_frame` form) gives the bytes and
relocations; `link` the linked bytes; `decodeItem` (or the padding/table readers) reads it
back. -/
def checkEnc (j : Json) : Except String Unit := do
  if let .ok (name : String) := get (α := String) j "item" then
    if name == "winPrologue" then return ← checkWinSeq j winPrologue
    if name == "winEpilogue" then return ← checkWinSeq j winEpilogue
  let item : Item ← get j "item"
  let pos : Nat ← get j "pos"
  let len : Nat ← get j "len"
  let sp : Option (BitVec 32) ← getOpt j "sp"
  let bytes ← (unhex (← get j "bytes")).elim (throw "bad hex") pure
  let relocs : List Reloc ← get j "relocs"
  let linked : Option String ← getOpt j "linked"
  let p32 := BitVec.ofNat 32 pos
  if !item.wf p32 then throw "not wf"
  let enc := match sp with
    | some f => item.spFrame f
    | none => item
  let (bs, rs) := enc.encode p32
  expectEq "bytes" (hex bs) (hex bytes)
  expectEq "relocs" rs relocs
  let code := placed pos len bytes
  match item with
  | .nop n =>
    expectEq "padding" ({ code, pos, fields := .relocs #[] : Cursor }.padding) n
  | .int3 => pure ()
  | .tableEntry base target =>
    expectEq "table entry" ({ code, pos, fields := .relocs #[] : Cursor }.tableEntry base) (some target)
  | _ =>
    let c : Cursor := { code, pos, fields := .relocs relocs.toArray, spFrame := sp }
    expectEq "decodeItem" (decodeItem c) (some (item, bytes.length))
    if let some l := linked then
      let lb := link (code0 + BitVec.ofNat 64 pos) addrOf bs (rs.map fun r => { r with pos := r.pos - pos })
      expectEq "linked bytes" (hex lb) l
      let c : Cursor := { code := placed pos len lb, pos, fields := .linked code0 record0 resolve, spFrame := sp }
      expectEq "decodeItem (linked)" (decodeItem c) (some (item, bytes.length))

/-- A decoding vector: `decodeItem` agrees with the Rust decoder on (mutated) bytes. -/
def checkDec (j : Json) : Except String Unit := do
  let pos : Nat ← get j "pos"
  let len : Nat ← get j "len"
  let sp : Option (BitVec 32) ← getOpt j "sp"
  let bytes ← (unhex (← get j "bytes")).elim (throw "bad hex") pure
  let relocs : Option (List Reloc) ← getOpt j "relocs"
  let result : Option Json ← getOpt j "result"
  let want : Option (Item × Nat) ← match result with
    | none => pure none
    | some r => do pure (some ((← get r "item"), (← get r "n")))
  let fields := match relocs with
    | some rs => .relocs rs.toArray
    | none => .linked code0 record0 resolve
  let c : Cursor := { code := placed pos len bytes, pos, fields, spFrame := sp }
  expectEq "decodeItem" (decodeItem c) want

def parseEntry (j : Json) : Except String (Option OsrEntry) := do
  if j.isNull then return none
  let landing : Nat ← get j "landing"
  let moves : List (List Int) ← get j "moves"
  let moves ← moves.mapM fun
    | [a, b, c] => pure (a, b, c.toNat)
    | _ => throw "bad move"
  pure (some { landing, moves })

/-- An OSR vector: `osrCode` gives `osr_code`'s bytes and probe fields, and `decodeOsr` reads
the bytes back to the same forms. -/
def checkOsr (j : Json) : Except String Unit := do
  let entries ← (← get (α := List Json) j "entries").mapM parseEntry
  let fAot : Nat ← get j "fAot"
  let fJit : Nat ← get j "fJit"
  let fp : Bool ← get j "fp"
  let farRt : Bool ← get j "farRt"
  let at_ : Nat ← get j "at"
  let code ← (unhex (← get j "code")).elim (throw "bad hex") pure
  let probes : List Nat ← get j "probes"
  let xs := osrCode entries fAot fJit fp farRt at_
  if !xs.all (·.wf 0) then throw "not wf"
  let (bs, rs) := encodeXItems xs at_
  expectEq "bytes" (hex bs) (hex code)
  expectEq "probes" (rs.map (·.pos - at_)) probes
  expectEq "probe relocs" (rs.all (·.to == .ref .probe)) true
  expectEq "decodeOsr" (decodeOsr code entries.length at_ probes) (some xs)

/-! ### Generated round trips -/

def disps : List (BitVec 32) :=
  [0, 1, 0xffffffff, 127, BitVec.ofInt 32 (-128), 128, BitVec.ofInt 32 (-129), 0x7fffffff,
    0x80000000, 0x12345678]
def imms : List (BitVec 32) :=
  [0, 1, 0xffffffff, 127, BitVec.ofInt 32 (-128), 128, BitVec.ofInt 32 (-129), 32767,
    BitVec.ofInt 32 (-32768), 32768, 0x7fffffff, 0x80000000]
def usableRegs : List Reg := Reg.all.filter (·.usable)
def mems : List M :=
  (Reg.all.filter (· != .rsp)).flatMap fun b => disps.map fun d => ⟨b, d⟩
def rms : List Rm := usableRegs.map .reg ++ mems.map .mem

/-- Every native form over every register, width, base, displacement and immediate class (the
`wf` ones), and the fixed forms over their parameters. -/
def generated : List Item :=
  let fixed : List Item := [.pushRbp, .callRax, .callMemRax, .jmpRax,
    .testAl, .testRax, .leave, .ret, .ud2, .loadTableEntry, .addRaxRcx]
  let refs : List Ref := [.handler 7, .probe, .func 3, .sym 9, .site 2, .const 64, .data 8,
    .ro 32, .record, .recordLoopCtr]
  let vals : List (BitVec 64) := [0, 1, 0xffffffff, 0x100000000, 0xffffffff80000000,
    0xffffffff7fffffff, 0x8000000000000000, 0xffffffffffffffff]
  fixed ++
  imms.flatMap (fun v => [.subRsp v, .addRsp v]) ++
  Reg.all.flatMap (fun r => vals.map (.setReg r) ++ refs.map (.lea r) ++ Reg.all.map (.mov r)) ++
  refs.flatMap (fun t => [.call t, .callMem t, .jmp t]) ++
  Reg.all.flatMap (fun r => refs.map (.loadRip r ·)) ++
  [.ctrInc false, .ctrInc true] ++ [0, 1, 127, 128, 255].map (.callR11 ·) ++
  W.all.flatMap (fun w =>
    usableRegs.flatMap (fun r =>
      [true, false].flatMap (fun sx => mems.map (.ld w sx r)) ++
      mems.map (.st w r) ++ mems.map (.leaM r) ++
      Alu.all.flatMap fun op => rms.map (.alu op w r)) ++
    imms.flatMap (fun imm =>
      mems.map (.stImm w · imm) ++ Alu.all.flatMap fun op => rms.map (.aluImm op w · imm)) ++
    usableRegs.flatMap (fun r =>
      rms.map (.imul w r) ++ imms.flatMap (fun imm => rms.map (.imulImm w r · imm)) ++
      [Sh.shl, .shr, .sar].flatMap fun op => [0, 1, 31, 32, 63, 255].map (.shift op w r))) ++
  Cond.all.flatMap (fun c => mems.map (.setcc c)) ++ mems.map .testM8 ++
  [4, 8, 16].flatMap (fun size => (List.range 8).flatMap fun x =>
    disps.flatMap fun d => [true, false].map fun st => .sse st size x ⟨.rbp, d⟩) ++
  usableRegs.flatMap (fun r => (List.range 8).flatMap fun x => [true, false].map (.movd · x r)) ++
  -- The forms of the variable shifts and rotates, `div`, `cttz`/`ctlz`, `cmp3` and `bswap`.
  usableRegs.flatMap (fun r =>
    [Sh.shl, .shr, .sar, .rol, .ror].flatMap (fun op => W.all.map (.shiftCl op · r)) ++
    [W.d, .q].flatMap (fun w => [.bswap w r] ++ rms.flatMap fun rm => [.bsf w r rm, .bsr w r rm]) ++
    Cond.all.flatMap (fun c => [.setccR c r] ++ rms.map (.cmov c .d r))) ++
  [W.d, .q].flatMap (fun w => [.cdq w] ++ rms.flatMap fun rm => [.div true w rm, .div false w rm])

/-- `decodeItem (encode i) = some (i, len)` for the generated `wf` items, unlinked and in the
`sp_frame` form; and `decodeItem` rejects the encodings of the non-`wf` ones (or reads another
item). (The PE prologue's and epilogue's instructions, which decode only inside their sequence,
are `checkWinSeq`'s.) -/
def roundTrip (frame : Option (BitVec 32)) : Except String Unit := do
  let pos : Nat := 100
  let fails := generated.filterMap fun i =>
    if !i.wf (BitVec.ofNat 32 pos) then none else
    let enc := match frame with
      | some f => i.spFrame f
      | none => i
    let (bs, rs) := enc.encode (BitVec.ofNat 32 pos)
    let code := placed pos (pos + bs.length + 4) bs
    let c : Cursor := { code, pos, fields := .relocs rs.toArray, spFrame := frame }
    if decodeItem c == some (i, bs.length) then none else some (repr i).pretty
  let n := (generated.filter (·.wf (BitVec.ofNat 32 pos))).length
  if n < 10000 then throw s!"only {n} items"
  if fails.isEmpty then pure () else
    throw s!"{fails.length} of {n} failed: {fails.take 5}"

/-- A non-`wf` item never decodes to itself. -/
def nonWfRejected : Except String Unit := do
  let pos : Nat := 100
  let bad : List Item := [.ld .d true .rax ⟨.rbp, 8⟩, .ld .b false .rsp ⟨.rbp, 8⟩,
    .alu .add .q .rbp (.reg .rax), .alu .add .q .rax (.reg .rsp), .imul .w .rax (.reg .rcx),
    .shift .shl .b .rax 1, .setcc .always ⟨.rax, 0⟩, .stImm .b ⟨.rax, 0⟩ 300,
    .aluImm .add .w (.reg .rax) 70000, .sse false 16 0 ⟨.rax, 0⟩, .st .q .rax ⟨.rsp, 0⟩,
    .shift .rol .d .rax 1, .bswap .w .rax, .div true .w (.reg .rcx), .cdq .b, .bsf .w .rax (.reg .rcx),
    .cmov .z .q .rax (.reg .rcx), .cmov .always .d .rax (.reg .rcx), .setccR .z .rcx,
    .setccR .always .rax]
  for i in bad do
    if i.wf (BitVec.ofNat 32 pos) then throw s!"{repr i} is wf"
    let (bs, rs) := i.encode (BitVec.ofNat 32 pos)
    let c : Cursor := { code := placed pos (pos + bs.length + 4) bs, pos, fields := .relocs rs.toArray }
    if (decodeItem c).map (·.1) == some i then throw s!"{repr i} decoded"

/-! ### Byte vectors of the extra forms -/

def xbytes (xs : List XItem) (pos : Nat := 0) : String := hex (encodeXItems xs pos).1

/-- `install.rs`: `lea r11, [rip + 5]; mov [rsp], r11; ret`. -/
def jitPrefix : Except String Unit := do
  expectEq "bytes" (xbytes jitEntryPrefix) "4c8d1d050000004c891c24c3"
  let code := (encodeXItems jitEntryPrefix).1.toArray
  expectEq "decode" (do
    let (a, n) ← decodeX { code, pos := 0, fields := .relocs #[] }
    let (b, m) ← decodeX { code, pos := n, fields := .relocs #[] }
    let (c, _) ← decodeX { code, pos := n + m, fields := .relocs #[] }
    pure [a, b, c]) (some jitEntryPrefix)

/-- `Item::CallAbs` (`mov r11, imm64; call r11`): its bytes and field, decoded from its
relocation and, linked, from the address its `imm64` holds. -/
def callAbs : Except String Unit := do
  let x := XItem.callAbs (.ref .probe)
  let (bs, rs) := encodeXItems [x] 7
  expectEq "bytes" (hex bs) "49bb000000000000000041ffd3"
  expectEq "relocs" rs [⟨9, .ref .probe⟩]
  let code := (List.replicate 7 (0 : UInt8) ++ bs).toArray
  expectEq "decode" (decodeX { code, pos := 7, fields := .relocs rs.toArray }) (some (x, 13))
  expectEq "no reloc" (decodeX { code, pos := 7, fields := .relocs #[] }) none
  let probeAt : BitVec 64 := 0x7f0012345678
  let linked := (List.replicate 7 (0 : UInt8) ++ [0x49, 0xbb] ++ leBytes probeAt 8 ++ [0x41, 0xff, 0xd3]).toArray
  let resolve := fun a => if a == probeAt then some (XRef.ref .probe) else none
  expectEq "linked" (decodeX { code := linked, pos := 7, fields := .linked 0x1000 resolve }) (some (x, 13))

/-- `objfile.rs`: the ELF and PE registry constructors' bytes and relocations. -/
def registry : Except String Unit := do
  let (bs, rs) := encodeXItems (registryCtor false false)
  expectEq "elf" (hex bs) "488d3d00000000488d3500000000e900000000"
  expectEq "elf relocs" rs [⟨3, .entriesStart⟩, ⟨10, .entriesEnd⟩, ⟨15, .vmRegister⟩]
  let (bs, rs) := encodeXItems (registryCtor true false)
  expectEq "pe" (hex bs) "488d0d00000000488d1500000000e900000000"
  expectEq "pe relocs" rs [⟨3, .entriesStart⟩, ⟨10, .entriesEnd⟩, ⟨15, .vmRegister⟩]
  let (bs, rs) := encodeXItems (registryCtor true true)
  expectEq "pe import" (hex bs) "488d0d00000000488d1500000000ff2500000000"
  expectEq "pe import relocs" rs [⟨3, .entriesStart⟩, ⟨10, .entriesEnd⟩, ⟨16, .vmRegisterImp⟩]
  for (pe, imp) in [(false, false), (true, false), (true, true)] do
    let xs := registryCtor pe imp
    let (bs, rs) := encodeXItems xs
    let code := bs.toArray
    let f := XFields.relocs rs.toArray
    let got := do
      let (a, n) ← decodeX { code, pos := 0, fields := f }
      let (b, m) ← decodeX { code, pos := n, fields := f }
      let (c, _) ← decodeX { code, pos := n + m, fields := f }
      pure [a, b, c]
    expectEq "decode" got (some xs)

/-- The counter stubs (`encode.rs`), as items: `tests/image.rs` checks the same bytes. -/
def stubs : Except String Unit := do
  let (bs, rs) := encodeItems (entryStub 10 false) 100
  expectEq "entry stub" (hex bs) "4c8d1d0000000041ff5308eb99"
  expectEq "entry stub relocs" rs [⟨103, .record⟩]
  let (bs, _) := encodeItems (headStub 0 10 true) 100
  expectEq "head stub" (hex bs) "4c8d1d0000000031c041ff5310e994ffffff"
  let (bs, _) := encodeItems (headStub 3 10 false) 100
  expectEq "head stub 3" (hex bs) "4c8d1d00000000b80300000041ff5310eb94"

/-! ### Semantics -/

def ctx : Ctx := { base := code0, addrOf }

def st0 : State :=
  { (default : State) with
    regs := fun i => BitVec.ofNat 64 (0x1111111111111111 * (i.val + 1) % 2 ^ 64),
    rip := code0 + 0x100 }
  |>.setReg .rsp 0x7fff0000 |>.setReg .rbp 0x7fff0100

def run (items : List Item) (s : State := st0) : Except String State :=
  (execItems ctx items s).mapError fun f => s!"fault {repr f}"

def flagsOf (cf zf sf of : Option Bool) : Flags := { cf, zf, sf, of }

def expectFlags (s : State) (f : Flags) : Except String Unit := expectEq "flags" s.flags f

def setup (vals : List (Reg × BitVec 64)) : State :=
  vals.foldl (fun s (r, v) => s.setReg r v) st0

def execTests : List TestCase := [
  ⟨"x86 exec shifts and rotates by cl", fun () => do
    let s0 := (setup [(.rax, 0x81), (.rcx, 0x101)]).setFlags (flagsOf false true false false)
    -- `rol al, cl` by 1 (`cl` 0x01): CF the new LSB, OF MSB xor CF, ZF/SF kept.
    let s ← run [.shiftCl .rol .b .rax] s0
    expectEq "rol8" (s.reg .rax) 0x03
    expectFlags s (flagsOf true true false true)
    let s ← run [.shiftCl .ror .w .rax] (s0.setReg .rcx 17)
    expectEq "ror16 by 17 (mod 16: 1)" (s.reg .rax) 0x8040
    let s ← run [.shiftCl .rol .b .rax] (s0.setReg .rcx 8)
    expectEq "rol8 by 8" (s.reg .rax) 0x81
    expectFlags s (flagsOf true true false none)
    let s ← run [.shiftCl .shl .q .rax] (s0.setReg .rcx 0x44)
    expectEq "shl64 by 0x44 & 63" (s.reg .rax) 0x810
    let s ← run [.shiftCl .shl .d .rax] (s0.setReg .rcx 32)
    expectEq "shl32 by 32 (masked 0)" (s.reg .rax) 0x81
    expectFlags s (flagsOf false true false false)
    let s ← run [.shiftCl .shr .b .rax] (s0.setReg .rcx 9)
    expectEq "shr8 by 9" (s.reg .rax) 0
    expectFlags s (flagsOf none true false none)⟩,
  ⟨"x86 exec div, cdq", fun () => do
    let s ← run [.cdq .d, .div true .d (.reg .rcx)] (setup [(.rax, 0xfffffff9), (.rcx, 2)])
    expectEq "idiv -7 / 2" (s.reg .rax, s.reg .rdx) (0xfffffffd, 0xffffffff)
    expectFlags s {}
    let s ← run [.setReg .rdx 0, .div false .q (.reg .rcx)] (setup [(.rax, 100), (.rcx, 7)])
    expectEq "div 100 / 7" (s.reg .rax, s.reg .rdx) (14, 2)
    expectEq "div by 0" (match execItems ctx [.div false .q (.reg .rcx)] (setup [(.rcx, 0)]) with
      | .error .divide => true
      | _ => false) true
    expectEq "idiv overflow" (match execItems ctx [.cdq .q, .div true .q (.reg .rcx)] (setup [(.rax, 0x8000000000000000), (.rcx, 0xffffffffffffffff)]) with
